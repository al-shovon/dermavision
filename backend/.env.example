# Copy this file to .env and start the server with:  uvicorn app.main:app --env-file .env
# Defaults are shown; you only need to set what you want to change.

# --- Pretrained model from Hugging Face (default) ---
MODEL_REPO=pthennakoon25/skinvision-ai-model
MODEL_FILE=best_model.pth
MODEL_ARCH=efficientnet_b0   # use tv_efficientnet_b0 if the Colab notebook says torchvision
MODEL_LABELS=akiec,bcc,bkl,df,mel,nv,vasc
PREPROCESS=squash
UNCERTAIN_BELOW=0.60
ALLOWED_ORIGINS=http://localhost:3000

# --- Later: your own model trained in Colab ---
# MODEL_PATH=weights/my_model.pth
# MODEL_NAME=DermaVision own EfficientNet-B0
# TEMPERATURE=1.3

# --- Production / free hosting: ONNX Runtime, no PyTorch needed ---
# After exporting dermavision.onnx from Colab into backend/weights/:
# MODEL_FORMAT=onnx
# MODEL_PATH=weights/dermavision.onnx
# ALLOWED_ORIGINS=https://your-site.vercel.app
